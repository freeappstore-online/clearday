{
  "name": "clearday",
  "description": "Track the days since you quit any habit. Calm, private, offline.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/clearday.git"
  },
  "scripts": {
    "dev": "pnpm --filter @clearday/web dev",
    "build": "pnpm --filter @clearday/web build",
    "preview": "pnpm --filter @clearday/web preview",
    "typecheck": "pnpm --filter @clearday/web exec tsc -b && tsc -p e2e",
    "test": "pnpm --filter @clearday/web test",
    "e2e": "pnpm build && playwright test",
    "live-check": "node scripts/live-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "typescript": "6.0.3"
  }
}
